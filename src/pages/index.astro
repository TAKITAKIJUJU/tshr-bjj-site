---
import Layout from '../layouts/SiteLayout.astro';
import Hero from '../components/site/Hero.astro';
import InfoStrip from '../components/site/v2/InfoStrip.astro';
import Concept from '../components/site/v2/Concept.astro';
import Instructor from '../components/site/v2/Instructor.astro';
import ClassFlow from '../components/site/v2/ClassFlow.astro';
import System from '../components/site/v2/System.astro';
import Schedule from '../components/site/v2/Schedule.astro';
import Facility from '../components/site/v2/Facility.astro';
import Access from '../components/site/v2/Access.astro';
import Faq from '../components/site/v2/Faq.astro';
import Contact from '../components/site/v2/Contact.astro';
import Footer from '../components/site/Footer.astro';
import BottomFixedCta from '../components/site/v2/BottomFixedCta.astro';
---

<Layout>
  <main id="main-content" class="home-page" tabindex="-1">
    <Hero />
    <InfoStrip />
    <Concept />
    <Instructor />
    <ClassFlow />
    <System />
    <Schedule />
    <Facility />
    <Access />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <BottomFixedCta />
</Layout>

<style>
  :global(html) {
    background-color: #1a1a1a !important;
  }
  :global(body) {
    --test-cta-height: calc(76px + env(safe-area-inset-bottom, 0px));
    background-color: #1a1a1a !important;
  }
</style>

<script>
 import { initHomeMotion } from '../scripts/site/motion';
 initHomeMotion();
 const bar = document.querySelector<HTMLElement>('.bottom-fixed-cta');
 if (bar) {
  const observer = new ResizeObserver(() => document.body.style.setProperty('--test-cta-height', bar.getBoundingClientRect().height + 'px'));
  observer.observe(bar);
  window.addEventListener('pagehide', () => observer.disconnect(), {once:true});
 }
</script>

