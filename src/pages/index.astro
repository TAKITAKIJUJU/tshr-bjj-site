---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Concept from '../components/Concept.astro';
import Instructor from '../components/Instructor.astro';
import ClassFlow from '../components/ClassFlow.astro';
import System from '../components/System.astro';
import Schedule from '../components/Schedule.astro';
import Access from '../components/Access.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import FloatingCta from '../components/FloatingCta.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Concept />
    <Instructor />
    <ClassFlow />
    <System />
    <Schedule />
    <Access />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <FloatingCta />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  // Smooth scrolling with Lenis
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
  });

  function raf(time: number) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);

  // Sync Lenis with ScrollTrigger
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });
  gsap.ticker.lagSmoothing(0);

  // Fade up animations
  gsap.utils.toArray('.fade-up').forEach((el: any) => {
    let delayVal = 0;
    if (el.style.transitionDelay) {
      delayVal = parseFloat(el.style.transitionDelay);
    }
    gsap.to(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 1,
      y: 0,
      filter: 'blur(0px)',
      duration: 1.4,
      delay: delayVal,
      ease: 'expo.out',
    });
  });

  // Fade in animations
  gsap.utils.toArray('.fade-in').forEach((el: any) => {
    let delayVal = 0;
    if (el.style.transitionDelay) {
      delayVal = parseFloat(el.style.transitionDelay);
    }
    gsap.to(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 90%', /* Trigger slightly earlier for fade-in */
        toggleActions: 'play none none none',
      },
      opacity: 1,
      filter: 'blur(0px)',
      duration: 1.6,
      delay: delayVal,
      ease: 'power2.out',
    });
  });

  // Slide left animations
  gsap.utils.toArray('.slide-left').forEach((el: any) => {
    let delayVal = 0;
    if (el.style.transitionDelay) {
      delayVal = parseFloat(el.style.transitionDelay);
    }
    gsap.to(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 1,
      x: 0,
      filter: 'blur(0px)',
      duration: 1.4,
      delay: delayVal,
      ease: 'expo.out',
    });
  });

  // Slide right animations
  gsap.utils.toArray('.slide-right').forEach((el: any) => {
    let delayVal = 0;
    if (el.style.transitionDelay) {
      delayVal = parseFloat(el.style.transitionDelay);
    }
    gsap.to(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 1,
      x: 0,
      filter: 'blur(0px)',
      duration: 1.4,
      delay: delayVal,
      ease: 'expo.out',
    });
  });
</script>
