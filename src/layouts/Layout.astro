---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  modernHeader?: boolean;
}

import Header from '../components/Header.astro';
import ModernHeader from '../components/site/TatoruHeader.astro';
import { entities } from '../data/site/entities';

const {
  title = '本庄市のブラジリアン柔術ジム｜Over Limit 本庄【本庄駅徒歩6分】',
  description = '本庄駅徒歩6分・無料駐車場完備。本庄市のブラジリアン柔術道場「Over Limit 本庄」。初心者・女性・キッズ大歓迎。世界大会王者（黒帯3段）が直接指導。見学・無料体験随時受付中！',
  canonical = Astro.url.pathname === '/' ? 'https://tshr-bjj.com/' : `https://tshr-bjj.com${Astro.url.pathname.replace(/\/$/, '')}/`,
  noindex = false,
  modernHeader = false,
} = Astro.props;

const canonicalUrl = canonical.startsWith('http') ? canonical : new URL(canonical, 'https://tshr-bjj.com').href;
const isHome = canonicalUrl === 'https://tshr-bjj.com/';
const isContact = canonicalUrl.includes('/contact');
const pageType = isContact ? 'ContactPage' : 'WebPage';
const base = 'https://tshr-bjj.com/';

const webpage = {
  '@type': pageType,
  '@id': canonicalUrl + '#webpage',
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: 'ja',
  isPartOf: { '@id': base + '#website' },
  about: { '@id': 'https://tshr-bjj.com/#sportsactivitylocation' },
  ...(isHome ? { mainEntity: { '@id': 'https://tshr-bjj.com/#sportsactivitylocation' } } : {})
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': base + '#website',
      name: 'Over Limit 本庄',
      url: base,
      inLanguage: 'ja',
      publisher: { '@id': base + '#sportsactivitylocation' }
    },
    ...entities.filter(e => isHome || ['SportsActivityLocation', 'Person', 'OfferCatalog', 'Course'].includes(e['@type'])),
    webpage,
    {
      '@type': 'BreadcrumbList',
      '@id': canonicalUrl + '#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: base },
        ...(!isHome ? [{ '@type': 'ListItem', position: 2, name: title, item: canonicalUrl }] : [])
      ]
    }
  ]
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="6Any9gIf8bYIO0x-BakavTduY23JcXYOblQO8mmCRIc" />
    <meta name="format-detection" content="telephone=no" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="本庄市, 柔術, ブラジリアン柔術, 本庄 格闘技, 本庄 ジム, 本庄市 習い事, Over Limit 本庄, 埼玉県, 上里町, 児玉町, 深谷市, 伊勢崎市, キッズ柔術, ダイエット, 護身術" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/LOGO.png" />
    <link rel="apple-touch-icon" href="/LOGO.png" />

    <!-- Open Graph / SNS -->
    <meta property="og:site_name" content="Over Limit 本庄" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://tshr-bjj.com/LOGO.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Over Limit 本庄 ブラジリアン柔術道場" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://tshr-bjj.com/LOGO.png" />

    <!-- Local / Geo SEO -->
    <meta name="geo.region" content="JP-11" />
    <meta name="geo.placename" content="本庄市" />
    <meta name="geo.position" content="36.23234;139.186255" />
    <meta name="ICBM" content="36.23234, 139.186255" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;0,900;1,800&family=Noto+Sans+JP:wght@400;500;600;700;800;900&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    {modernHeader ? <ModernHeader languageHomeOnly /> : <Header />}
    <slot />
  </body>
</html>

<style>
  .skip-link { position:fixed; top:8px; left:8px; z-index:1005; padding:12px; background:white; color:#141613; transform:translateY(-160%); text-decoration:none; font-weight:700; font-size:13px; border:1px solid #ccc; border-radius:4px; }
  .skip-link:focus { transform:none; }
</style>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
