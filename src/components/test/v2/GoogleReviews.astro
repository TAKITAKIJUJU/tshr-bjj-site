---
// GoogleReviews.astro - Googleマップのクチコミ（白背景・Googleウィジェット風スライダー）
---

<section class="reviews-section" id="reviews" aria-labelledby="reviews-title">
  <div class="reviews-container">
    <div class="reviews-header">
      <div class="google-badge-pill">
        <svg viewBox="0 0 24 24" width="16" height="16" class="google-icon" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Google Reviews</span>
      </div>
      <h2 id="reviews-title" class="reviews-title">Googleマップのクチコミ</h2>
      <p class="reviews-subtitle">Googleマップに寄せられたクチコミから掲載しています。</p>
    </div>

    <!-- Slider Wrapper with side arrows -->
    <div class="slider-wrapper">
      <button type="button" class="slider-arrow prev" data-slider-prev aria-label="前のクチコミ">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M15 19l-7-7 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="reviews-track" data-reviews-track tabindex="0" aria-label="クチコミ一覧（横にスクロールできます）">

        <!-- Card 1 -->
        <article class="review-card">
          <div class="card-header">
            <div class="avatar-wrap">
              <div class="avatar" style="background: #795548;" aria-hidden="true">I</div>
              <span class="guide-badge" title="Local Guide" aria-hidden="true">★</span>
            </div>
            <div class="user-meta">
              <span class="user-name">Ichiro Matsumoto</span>
              <span class="review-date">2年前・Googleマップ</span>
            </div>
            <div class="google-logo" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
          </div>
          <div class="card-stars" role="img" aria-label="星5つ">★★★★★</div>
          <p class="review-body">とても広いマットスペースがあり、更衣スペースも保護者や見学の方が座って過ごせるスペースも十分にある素敵なジムです。

代表のタシロ先生はとても気さくでフレンドリーな性格で、初めての方も緊張せず話すことができて、楽しく柔術を始めることができると思います。
会員さんは日系ブラジリアンの方が多い印象ですが、どなたでも障壁なく柔術が楽しめるいいジムだと思います。</p>
        </article>

        <!-- Card 2 -->
        <article class="review-card">
          <div class="card-header">
            <div class="avatar-wrap">
              <div class="avatar" style="background: #3949ab;" aria-hidden="true">1</div>
              <span class="guide-badge" title="Local Guide" aria-hidden="true">★</span>
            </div>
            <div class="user-meta">
              <span class="user-name">100 mendou</span>
              <span class="review-date">3年前・Googleマップ</span>
            </div>
            <div class="google-logo" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
          </div>
          <div class="card-stars" role="img" aria-label="星5つ">★★★★★</div>
          <p class="review-body">上里町から本庄駅前に引っ越したばかりで白を基調にしたとてもキレイな柔術道場。先生はとても細かく丁寧に教えてくれます。
スパーリングも自由参加、筋トレとか辛い指導はありません。</p>
        </article>

        <!-- Card 3 -->
        <article class="review-card">
          <div class="card-header">
            <div class="avatar-wrap">
              <div class="avatar" style="background: #e65100;" aria-hidden="true">E</div>
              <span class="guide-badge" title="Local Guide" aria-hidden="true">★</span>
            </div>
            <div class="user-meta">
              <span class="user-name">Eduardo Pereira</span>
              <span class="review-date">4年前・Googleマップ</span>
            </div>
            <div class="google-logo" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
          </div>
          <div class="card-stars" role="img" aria-label="星5つ">★★★★★</div>
          <div class="translation-note">※ポルトガル語からの翻訳</div>
          <p class="review-body">最高です、本当におすすめです！柔術について素晴らしい指導が受けられますし、クラスの構成も非常にしっかりしていて、先生から直接指導を受けられます。</p>
        </article>

      </div>

      <button type="button" class="slider-arrow next" data-slider-next aria-label="次のクチコミ">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background: #ffffff;
    padding: 44px 0 48px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    overflow: hidden;
  }

  .reviews-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .reviews-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 28px;
  }

  .google-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 12px;
    background: #f1f3f4;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #3c4043;
    margin-bottom: 10px;
  }

  .google-icon {
    display: block;
    flex-shrink: 0;
  }

  .reviews-title {
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    line-height: 1.3;
    margin: 0 0 8px;
  }

  .reviews-subtitle {
    font-size: 0.88rem;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  /* Slider Wrapper */
  .slider-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Slider Arrows (image-matched style: subtle gray chevron buttons) */
  .slider-arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: #c4c7c5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
    padding: 0;
  }

  .slider-arrow:hover {
    color: #1f1f1f;
    background: #f1f3f4;
  }

  .slider-arrow:active {
    background: #e8eaed;
  }

  /* Reviews Track */
  .reviews-track {
    flex: 1 1 auto;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 4px 2px 14px;
    margin: 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
  }

  .reviews-track::-webkit-scrollbar {
    height: 5px;
  }

  .reviews-track::-webkit-scrollbar-track {
    background: transparent;
  }

  .reviews-track::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 999px;
  }

  /* Review Card (Image-matched light gray background with rounded corners) */
  .review-card {
    flex: 0 0 calc((100% - 32px) / 3);
    min-width: 290px;
    max-width: 380px;
    scroll-snap-align: start;
    background: #f6f7f9;
    border-radius: 12px;
    padding: 20px 22px;
    border: 1px solid rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: box-shadow 0.2s ease;
  }

  .review-card:hover {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  }

  /* Card Header */
  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .avatar-wrap {
    position: relative;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .guide-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #ff6d00;
    color: #ffffff;
    font-size: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #ffffff;
  }

  .user-meta {
    flex: 1 1 auto;
    min-width: 0;
  }

  .user-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    color: #1f1f1f;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .review-date {
    display: block;
    font-size: 0.72rem;
    color: #70757a;
    margin-top: 1px;
  }

  .google-logo {
    flex-shrink: 0;
    opacity: 0.95;
    display: flex;
    align-items: center;
  }

  /* Stars */
  .card-stars {
    color: #fbbc04;
    font-size: 1rem;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    line-height: 1;
  }

  .translation-note {
    font-size: 0.68rem;
    color: #70757a;
    margin-bottom: 6px;
    font-weight: 500;
  }

  /* Body */
  .review-body {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #2c2d30;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .review-card {
      flex: 0 0 calc((100% - 16px) / 2);
    }
  }

  @media (max-width: 640px) {
    .reviews-section {
      padding: 32px 0 36px;
    }

    .reviews-container {
      padding: 0 12px;
    }

    .slider-arrow {
      display: none; /* Mobile handles touch scroll directly */
    }

    .reviews-track {
      gap: 12px;
      padding: 2px 4px 12px;
      margin: 0 -12px;
      padding-left: 12px;
      padding-right: 12px;
    }

    .review-card {
      flex: 0 0 85vw;
      max-width: 320px;
      min-width: 270px;
      padding: 16px 18px;
    }

    .reviews-header {
      margin-bottom: 20px;
    }
  }
</style>

<script>
  function initReviewsSlider() {
    const track = document.querySelector('[data-reviews-track]');
    const prevBtn = document.querySelector('[data-slider-prev]');
    const nextBtn = document.querySelector('[data-slider-next]');

    if (!track) return;

    const scrollAmount = () => {
      const card = track.querySelector('.review-card');
      return card ? card.getBoundingClientRect().width + 16 : 320;
    };

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewsSlider);
  } else {
    initReviewsSlider();
  }
</script>
