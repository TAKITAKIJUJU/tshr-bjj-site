---
// GoogleReviews.astro - Googleマップのクチコミ（横スクロール・コンパクト版）
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="reviews-head motion-up">
      <div>
        <p class="eyebrow">Google Reviews</p>
        <h2 id="reviews-title">Googleマップのクチコミ</h2>
      </div>
      <div class="reviews-nav" data-reviews-nav>
        <span class="reviews-count" aria-hidden="true"><b data-reviews-current>01</b> / <span data-reviews-total>03</span></span>
        <button type="button" class="nav-btn" data-reviews-prev aria-label="前のクチコミ">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
        </button>
        <button type="button" class="nav-btn" data-reviews-next aria-label="次のクチコミ">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
        </button>
      </div>
    </div>
    <p class="reviews-lead motion-up" data-motion-delay="0.1">Googleマップに寄せられたクチコミから掲載しています。出稽古・見学で来られた方や、以前通われていた方の投稿も含みます。</p>
  </div>

  <div class="reviews-viewport">
    <ol class="reviews-track" data-reviews-track tabindex="0" aria-label="クチコミ一覧（横にスクロールできます）">

      <li class="review-card">
        <div class="card-head">
          <span class="card-number">01</span>
          <span class="stars" role="img" aria-label="星5つ">★★★★★</span>
        </div>
        <p class="review-highlight">どなたでも障壁なく柔術が楽しめるいいジム</p>
        <p class="review-body">とても広いマットスペースがあり、更衣スペースも保護者や見学の方が座って過ごせるスペースも十分にある素敵なジムです。

代表のタシロ先生はとても気さくでフレンドリーな性格で、初めての方も緊張せず話すことができて、楽しく柔術を始めることができると思います。
会員さんは日系ブラジリアンの方が多い印象ですが、どなたでも障壁なく柔術が楽しめるいいジムだと思います。</p>
        <footer class="card-foot">
          <div class="reviewer">
            <span class="avatar" aria-hidden="true">I</span>
            <span class="reviewer-text"><span class="name">Ichiro Matsumoto</span><span class="source">Google マップ</span></span>
          </div>
        </footer>
      </li>

      <li class="review-card">
        <div class="card-head">
          <span class="card-number">02</span>
          <span class="stars" role="img" aria-label="星5つ">★★★★★</span>
        </div>
        <p class="review-highlight">先生はとても細かく丁寧に教えてくれます。</p>
        <p class="review-body">上里町から本庄駅前に引っ越したばかりで白を基調にしたとてもキレイな柔術道場。先生はとても細かく丁寧に教えてくれます。
スパーリングも自由参加、筋トレとか辛い指導はありません。</p>
        <footer class="card-foot">
          <div class="reviewer">
            <span class="avatar" aria-hidden="true">1</span>
            <span class="reviewer-text"><span class="name">100 mendou</span><span class="source">Google マップ</span></span>
          </div>
        </footer>
      </li>

      <li class="review-card">
        <div class="card-head">
          <span class="card-number">03</span>
          <span class="stars" role="img" aria-label="星5つ">★★★★★</span>
        </div>
        <p class="review-highlight">柔術について素晴らしい指導が受けられます</p>
        <p class="review-body">最高です、本当におすすめです！柔術について素晴らしい指導が受けられますし、クラスの構成も非常にしっかりしていて、先生から直接指導を受けられます。</p>
        <span class="translation-tag">※ポルトガル語からの翻訳</span>
        <footer class="card-foot">
          <div class="reviewer">
            <span class="avatar" aria-hidden="true">E</span>
            <span class="reviewer-text"><span class="name">Eduardo Pereira</span><span class="source">Google マップ</span></span>
          </div>
        </footer>
      </li>

    </ol>
  </div>
</section>

<style>
  .reviews {
    --rv-bg: #141613;
    --rv-card: #1b1e19;
    --rv-line: #2f332c;
    --rv-text: #f4f4ee;
    --rv-muted: #a2a799;
    --rv-accent: #ff6b00;
    --rv-edge: max(24px, calc((100vw - 1220px) / 2));
    position: relative;
    padding-block: 48px 44px;
    background: var(--rv-bg);
    color: var(--rv-text);
    font-family: 'Noto Sans JP', sans-serif;
    overflow: hidden;
  }

  /* subtle mat-grid texture */
  .reviews::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .wrap {
    position: relative;
    width: min(1220px, calc(100% - 48px));
    margin-inline: auto;
  }

  .reviews-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--rv-text);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: 'Oswald', Impact, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rv-accent);
  }

  .eyebrow::before {
    content: "";
    width: 6px;
    height: 6px;
    background: currentColor;
  }

  .reviews-head h2 {
    margin: 4px 0 0;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .reviews-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .reviews-count {
    margin-right: 6px;
    font-family: 'Oswald', Impact, sans-serif;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--rv-muted);
  }

  .reviews-count b {
    color: var(--rv-text);
    font-weight: 700;
  }

  .nav-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--rv-line);
    background: transparent;
    color: var(--rv-text);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s, opacity 0.2s;
  }

  .nav-btn:hover:not(:disabled) {
    background: var(--rv-accent);
    border-color: var(--rv-accent);
    color: #141613;
  }

  .nav-btn:focus-visible {
    outline: 2px solid var(--rv-accent);
    outline-offset: 2px;
  }

  .nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .reviews-nav.is-static {
    visibility: hidden;
  }

  .reviews-lead {
    max-width: 620px;
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--rv-muted);
  }

  /* ---- horizontal track ---- */
  .reviews-viewport {
    position: relative;
    margin-top: 24px;
  }

  .reviews-track {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 2px var(--rv-edge) 14px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--rv-edge);
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--rv-accent) var(--rv-line);
  }

  .reviews-track:focus-visible {
    outline: 2px solid var(--rv-accent);
    outline-offset: -2px;
  }

  .reviews-track::-webkit-scrollbar { height: 3px; }
  .reviews-track::-webkit-scrollbar-track { background: var(--rv-line); }
  .reviews-track::-webkit-scrollbar-thumb { background: var(--rv-accent); }

  .review-card {
    position: relative;
    flex: 0 0 clamp(280px, 82vw, 360px);
    display: flex;
    flex-direction: column;
    padding: 20px 20px 16px;
    background: var(--rv-card);
    border: 1px solid var(--rv-line);
    border-top: 3px solid var(--rv-accent);
    scroll-snap-align: start;
    transition: border-color 0.25s, transform 0.25s;
  }

  /* quote mark */
  .review-card::after {
    content: "“";
    position: absolute;
    top: 4px;
    right: 14px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 64px;
    line-height: 1;
    color: var(--rv-accent);
    opacity: 0.14;
    pointer-events: none;
  }

  @media (hover: hover) {
    .review-card:hover {
      border-color: #4a4f45;
      border-top-color: var(--rv-accent);
      transform: translateY(-3px);
    }
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .card-number {
    font-family: 'Oswald', Impact, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--rv-accent);
  }

  .stars {
    font-size: 14px;
    letter-spacing: 2px;
    color: #fbbc04;
  }

  .review-highlight {
    margin: 0 0 10px;
    padding-right: 24px;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--rv-text);
  }

  .review-body {
    flex-grow: 1;
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.75;
    color: #c9ccc1;
    white-space: pre-line;
  }

  .translation-tag {
    align-self: flex-start;
    margin: -4px 0 12px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
    color: var(--rv-muted);
    border: 1px solid var(--rv-line);
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--rv-line);
  }

  .reviewer {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    background: var(--rv-text);
    color: #141613;
    font-family: 'Oswald', Impact, sans-serif;
    font-size: 15px;
    font-weight: 700;
  }

  .reviewer-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name {
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .source {
    font-size: 11px;
    color: var(--rv-muted);
  }

  @media (max-width: 860px) {
    .reviews {
      --rv-edge: 16px;
      padding-block: 36px 32px;
    }
    .wrap {
      width: calc(100% - 32px);
    }
    .reviews-head {
      align-items: flex-end;
    }
    .reviews-nav .nav-btn {
      width: 36px;
      height: 36px;
    }
    .reviews-count {
      display: none;
    }
    .reviews-viewport {
      margin-top: 18px;
    }
    .reviews-track {
      gap: 12px;
      padding-bottom: 10px;
    }
    .review-card {
      padding: 16px 16px 14px;
    }
    .review-highlight {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .review-card,
    .nav-btn {
      transition: none;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-reviews-track]');
  const nav = document.querySelector<HTMLElement>('[data-reviews-nav]');
  const prev = document.querySelector<HTMLButtonElement>('[data-reviews-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-reviews-next]');
  const current = document.querySelector<HTMLElement>('[data-reviews-current]');
  const total = document.querySelector<HTMLElement>('[data-reviews-total]');

  if (track && nav && prev && next) {
    const cards = Array.from(track.children) as HTMLElement[];
    const pad = (n: number) => String(n).padStart(2, '0');
    if (total) total.textContent = pad(cards.length);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const step = () => {
      const first = cards[0];
      if (!first) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      return first.getBoundingClientRect().width + gap;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      nav.classList.toggle('is-static', max <= 2);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
      const index = max <= 2 ? 0 : Math.min(cards.length - 1, Math.round(track.scrollLeft / step()));
      if (current) current.textContent = pad(track.scrollLeft >= max - 2 && max > 2 ? cards.length : index + 1);
    };

    const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: reduced ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    });

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    }, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }
</script>
