---
// Contact.astro v2 - Current tshr-bjj.com style with person (last.webp) in background & Orange accents
---

<section class="contact-section" id="contact">
  <div class="contact-card motion-scale">
    <div class="contact-inner">
      <div class="contact-copy">
        <h2 class="contact-title">
          まずは無料体験から<br />
          始めてみませんか？
        </h2>
        <p class="contact-text">
          見学・体験ともに無料です。お気軽にお問い合わせください。<br />
          体験には動きやすい服装・タオル・飲み物をご用意ください。日程未定でもご相談いただけます。
        </p>
      </div>
      <div class="contact-actions">
        <a href="/test/contact/" class="contact-btn contact-btn--trial">
          <span>無料体験を予約する</span>
          <svg class="btn-icon btn-icon--mail" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
        </a>
        <a href="https://line.me/ti/p/edZnSmCFIj" target="_blank" rel="noopener" class="contact-btn contact-btn--line">
          <span>LINEで相談する</span>
          <svg class="btn-icon btn-icon--line" viewBox="50 50 220 205" width="20" height="20" aria-hidden="true">
            <path fill="#ffffff" d="M266.66,144.92c0-47.74-47.86-86.58-106.69-86.58S53.28,97.18,53.28,144.92c0,42.8,38,78.65,89.22,85.42,3.48.75,8.21,2.29,9.4,5.26,1.08,2.7.71,6.93.35,9.65,0,0-1.25,7.53-1.52,9.13-.47,2.7-2.15,10.55,9.24,5.76s61.44-36.18,83.82-61.95h0C259.25,181.24,266.66,164,266.66,144.92Z"/>
            <path fill="#06c755" d="M231.16,172.49h-30a2,2,0,0,1-2-2v0h0V123.94h0v0a2,2,0,0,1,2-2h30a2,2,0,0,1,2,2v7.57a2,2,0,0,1-2,2H210.79v7.85h20.37a2,2,0,0,1,2,2V151a2,2,0,0,1-2,2H210.79v7.86h20.37a2,2,0,0,1,2,2v7.56A2,2,0,0,1,231.16,172.49Z"/>
            <path fill="#06c755" d="M120.29,172.49a2,2,0,0,0,2-2v-7.56a2,2,0,0,0-2-2H99.92v-37a2,2,0,0,0-2-2H90.32a2,2,0,0,0-2,2v46.53h0v0a2,2,0,0,0,2,2h30Z"/>
            <rect fill="#06c755" x="128.73" y="121.85" width="11.64" height="50.64" rx="2.04"/>
            <path fill="#06c755" d="M189.84,121.85h-7.56a2,2,0,0,0-2,2v27.66l-21.3-28.77a1.2,1.2,0,0,0-.17-.21v0l-.12-.12,0,0-.11-.09-.06,0-.11-.08-.06,0-.11-.06-.07,0-.11,0-.07,0-.12,0-.08,0-.12,0h-.08l-.11,0h-7.71a2,2,0,0,0-2,2v46.56a2,2,0,0,0,2,2h7.57a2,2,0,0,0,2-2V142.81l21.33,28.8a2,2,0,0,0,.52.52h0l.12.08.06,0,.1.05.1,0,.07,0,.14,0h0a2.42,2.42,0,0,0,.54.07h7.52a2,2,0,0,0,2-2V123.89A2,2,0,0,0,189.84,121.85Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 0;
    background: #141613;
    overflow: hidden;
  }

  .contact-card {
    width: 100%;
    min-height: clamp(300px, 35vw, 400px);
    padding: clamp(40px, 5vw, 64px) clamp(24px, 5vw, 64px);
    background:
      linear-gradient(90deg, rgba(14, 16, 13, 0.88) 0%, rgba(14, 16, 13, 0.72) 48%, rgba(14, 16, 13, 0.35) 100%),
      url('/last.webp') right center / cover no-repeat;
    display: flex;
    align-items: center;
  }

  .contact-inner {
    max-width: 1220px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(28px, 5vw, 60px);
  }

  .contact-copy {
    flex: 1 1 auto;
    max-width: 740px;
  }

  .contact-title {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: clamp(2rem, 4.2vw, 3.8rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.32;
    letter-spacing: -0.02em;
    margin: 0 0 clamp(16px, 2vw, 24px);
    text-shadow: 0 3px 20px rgba(0, 0, 0, 0.6);
  }

  .contact-text {
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    color: rgba(255, 255, 255, 0.94);
    font-weight: 500;
    line-height: 1.75;
    margin: 0;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: min(100%, 340px);
    flex: 0 0 min(100%, 340px);
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 64px;
    padding: 16px 24px;
    border-radius: 8px;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .contact-btn--trial {
    background: #ff6b00;
    color: #141613;
    box-shadow: none;
  }

  .contact-btn--trial:hover {
    background: #ff8533;
    transform: translateY(-2px);
  }

  .contact-btn--line {
    background: #06c755;
    color: #ffffff;
    box-shadow: none;
  }

  .contact-btn--line:hover {
    background: #05b34c;
    transform: translateY(-2px);
  }

  .btn-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .contact-btn--trial:hover .btn-icon {
    transform: translateY(-1px) scale(1.08);
  }

  .contact-btn--line:hover .btn-icon {
    transform: scale(1.1);
  }

  @media (max-width: 860px) {
    .contact-card {
      padding: 36px 20px 40px;
      min-height: auto;
      background:
        linear-gradient(180deg, rgba(14, 16, 13, 0.92) 0%, rgba(14, 16, 13, 0.75) 60%, rgba(14, 16, 13, 0.85) 100%),
        url('/last.webp') center 20% / cover no-repeat;
    }

    .contact-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
    }

    .contact-actions {
      width: 100%;
      flex: auto;
    }

    .contact-title {
      font-size: clamp(1.6rem, 7vw, 2.2rem);
    }
  }
</style>
