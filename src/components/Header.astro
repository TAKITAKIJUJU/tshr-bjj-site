---
// Header - ballaholic style: minimal, clean, with accent color logo
---

<header class="header" id="header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <span class="header__logo-mark">OL</span>
      <span class="header__logo-text">
        <span class="header__logo-name">OVER LIMIT</span>
        <span class="header__logo-sub">H O N J O</span>
      </span>
    </a>

    <nav class="header__nav" id="nav-menu">
      <a href="#concept" class="header__link">Concept</a>
      <a href="#instructor" class="header__link">Instructor</a>
      <a href="#system" class="header__link">Price</a>
      <a href="#schedule" class="header__link">Schedule</a>
      <a href="#access" class="header__link">Access</a>
      <a href="#contact" class="header__link header__link--cta">
        Contact
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </nav>

    <button class="header__burger" id="burger-btn" aria-label="Menu">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__curtain" aria-hidden="true"></div>
  <nav class="mobile-menu__nav">
    <a href="#concept" class="mobile-menu__link">Concept</a>
    <a href="#instructor" class="mobile-menu__link">Instructor</a>
    <a href="#system" class="mobile-menu__link">Price</a>
    <a href="#schedule" class="mobile-menu__link">Schedule</a>
    <a href="#access" class="mobile-menu__link">Access</a>
    <a href="#contact" class="mobile-menu__link mobile-menu__link--cta">Contact</a>
  </nav>
  <div class="mobile-menu__footer">
    <a href="https://www.instagram.com/tshr_jiujitsu/" target="_blank" rel="noopener">Instagram</a>
    <a href="https://www.facebook.com/groups/304416070927536" target="_blank" rel="noopener">Facebook</a>
  </div>
</div>

<script>
  const burger = document.getElementById('burger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.getElementById('header');
  const mobileLinks = document.querySelectorAll('.mobile-menu__link');

  const openMenu = () => {
    burger?.classList.add('active');
    mobileMenu?.classList.add('open');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    burger?.classList.remove('active');
    mobileMenu?.classList.remove('open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  burger?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('open')) {
      closeMenu();
      return;
    }
    openMenu();
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (currentScroll > 100) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });
</script>

<style>
  :global(html.js-motion) .header {
    opacity: 0;
    transform: translate3d(0, -48px, 0);
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 14px 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header.scrolled {
    padding: 9px 0;
    background: rgba(255, 255, 255, 0.74);
    border-bottom: 1px solid rgba(12, 12, 12, 0.08);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    box-shadow:
      8px 8px 18px rgba(156, 166, 189, 0.24),
      -8px -8px 16px rgba(255, 255, 255, 0.88);
  }

  .header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(20px, 3vw, 32px);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1001;
  }

  .header__logo-mark {
    font-family: 'Inter', sans-serif;
    font-size: 1.4rem;
    font-weight: 900;
    color: #FF6A00;
    letter-spacing: -0.03em;
  }

  .header__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .header__logo-name {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #F8F8F8;
  }

  .header__logo-sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.68);
    margin-top: 2px;
  }

  .header__nav {
    display: none;
  }

  .header__link {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.92);
    transition: color 0.3s ease;
    position: relative;
  }

  .header__link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #FF6A00;
    border-radius: 1px;
    transition: width 0.3s ease;
  }

  .header__link:hover { color: #FF6A00; }
  .header__link:hover::after { width: 100%; }

  .header__link--cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.96);
    color: #0A0A0A !important;
    border-radius: 60px;
    transition: all 0.3s ease;
  }

  .header__link--cta::after { display: none; }
  .header__link--cta:hover {
    background: #FF6A00;
    color: #FFFFFF !important;
    transform: translateY(-1px);
  }

  .header__burger {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 1001;
  }

  .header__burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #FFFFFF;
    border-radius: 1px;
    transition: all 0.3s ease;
  }

  .header.scrolled .header__logo-name {
    color: #0E0E10;
  }

  .header.scrolled .header__logo-sub {
    color: #8B8C92;
  }

  .header.scrolled .header__link {
    color: #111112;
  }

  .header.scrolled .header__link--cta {
    background: #FF6A00;
    color: #FFFFFF !important;
  }

  .header.scrolled .header__burger span {
    background: #1A1A1A;
  }

  .header__burger.active span:first-child {
    transform: rotate(45deg) translate(3px, 3px);
  }

  .header__burger.active span:last-child {
    transform: rotate(-45deg) translate(3px, -3px);
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-menu.open {
    visibility: visible;
    pointer-events: all;
  }

  .mobile-menu__curtain {
    position: absolute;
    inset: 0;
    background: #FF6A00;
    transform: scaleX(0);
    transform-origin: center right;
    transition: transform 1s cubic-bezier(0.42, 0, 0.6, 1.19);
  }

  .mobile-menu.open .mobile-menu__curtain {
    transform: scaleX(1);
  }

  .mobile-menu__nav {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.5s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0s;
  }

  .mobile-menu.open .mobile-menu__nav {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.45s;
  }

  .mobile-menu__link {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    opacity: 0;
    transform: translateY(16px);
    transition:
      color 0.3s ease,
      opacity 0.45s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu__link:hover { color: #FF6A00; }

  .mobile-menu.open .mobile-menu__link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu.open .mobile-menu__link:nth-child(1) { transition-delay: 0.54s; }
  .mobile-menu.open .mobile-menu__link:nth-child(2) { transition-delay: 0.62s; }
  .mobile-menu.open .mobile-menu__link:nth-child(3) { transition-delay: 0.7s; }
  .mobile-menu.open .mobile-menu__link:nth-child(4) { transition-delay: 0.78s; }
  .mobile-menu.open .mobile-menu__link:nth-child(5) { transition-delay: 0.86s; }
  .mobile-menu.open .mobile-menu__link:nth-child(6) { transition-delay: 0.94s; }

  .mobile-menu__link--cta {
    color: #FF6A00;
  }

  .mobile-menu__footer {
    position: absolute;
    bottom: 48px;
    display: flex;
    gap: 24px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.45s ease, transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.3s;
    z-index: 1;
  }

  .mobile-menu.open .mobile-menu__footer {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.95s;
  }

  .mobile-menu__footer a {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #A4A4AC;
    transition: color 0.3s;
  }

  .mobile-menu__footer a:hover { color: #FF6A00; }

  @media (max-width: 768px) {
    .header__inner { padding: 0 20px; }
  }
</style>

