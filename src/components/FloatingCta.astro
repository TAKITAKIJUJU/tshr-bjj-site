---
// Floating CTA - ballaholic style: orange pill
---

<div class="floating-cta" id="floating-cta">
  <a href="#contact" class="floating-cta__btn">
    <span class="floating-cta__text floating-cta__text--desktop">無料体験</span>
    <span class="floating-cta__text floating-cta__text--mobile">無料<br>体験</span>
    <svg class="floating-cta__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M7 17L17 7M17 7H7M17 7V17" />
    </svg>
  </a>
</div>

<script>
  const floatingCta = document.getElementById('floating-cta');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 600) {
      floatingCta?.classList.add('visible');
    } else {
      floatingCta?.classList.remove('visible');
    }
  });
</script>

<style>
  .floating-cta {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 900;
    opacity: 0;
    transform: translateY(20px) scale(0.9);
    pointer-events: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-cta.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  .floating-cta__btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 28px;
    background: #FF6A00;
    border-radius: 60px;
    color: #fff;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .floating-cta__btn:hover {
    transform: translateY(-3px);
  }

  .floating-cta__text {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .floating-cta__text--mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .floating-cta {
      bottom: 20px;
      right: 20px;
    }
    .floating-cta__btn {
      width: 64px;
      height: 64px;
      padding: 0;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .floating-cta__text--desktop {
      display: none;
    }
    .floating-cta__text--mobile {
      display: block;
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      line-height: 1.3;
      text-align: center;
    }
    .floating-cta__arrow {
      display: none;
    }
  }
</style>

