---
// Footer - ballaholic style: minimal
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__logo-mark">OL</span>
        <div class="footer__logo-text">
          <span class="footer__logo-name">OVER LIMIT</span>
          <span class="footer__logo-sub">H O N J O</span>
        </div>
      </div>
      <div class="footer__links">
        <a href="https://www.instagram.com/tshr_jiujitsu/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/groups/304416070927536" target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copy">&copy; Over Limit 本庄. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #1A1A1A;
    padding: 48px 0 32px;
  }

  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 24px;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__logo-mark {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    color: #FF5E1A;
  }

  .footer__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .footer__logo-name {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #fff;
  }

  .footer__logo-sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.3);
    margin-top: 2px;
  }

  .footer__links {
    display: flex;
    gap: 24px;
  }

  .footer__links a {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.4);
    transition: color 0.3s ease;
  }

  .footer__links a:hover {
    color: #FF5E1A;
  }

  .footer__bottom {
    text-align: center;
  }

  .footer__copy {
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.2);
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .footer__top {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
    .footer__inner { padding: 0 20px; }
  }
</style>
