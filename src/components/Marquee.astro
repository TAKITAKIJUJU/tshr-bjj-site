---
// Marquee.astro - Infinite scrolling text with split color
---

<div class="marquee-split">
  <!-- Top half: white text -->
  <div class="marquee-half marquee-half--top">
    <div class="marquee-track">
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
    </div>
  </div>
  <!-- Bottom half: black text -->
  <div class="marquee-half marquee-half--bottom">
    <div class="marquee-track">
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-item">BRAZILIAN JIU-JITSU ACADEMY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
    </div>
  </div>
</div>

<style>
  .marquee-split {
    position: relative;
    width: 100%;
    height: clamp(5rem, 14vw, 12rem);
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    z-index: 15;
  }

  .marquee-half {
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Top half: dark bg, white text, clip to top 50% */
  .marquee-half--top {
    top: 0;
    clip-path: inset(0 0 calc(50% - 1px) 0);
    background: #0A0A0A;
  }

  /* Bottom half: transparent bg (site gradient shows), black text, clip to bottom 50% */
  .marquee-half--bottom {
    top: 0;
    clip-path: inset(50% 0 0 0);
    background: transparent;
  }

  .marquee-track {
    display: flex;
    align-items: center;
    height: 100%;
    width: max-content;
    animation: marquee-scroll 30s linear infinite;
  }

  .marquee-item {
    font-family: 'Inter', sans-serif;
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    white-space: nowrap;
    line-height: 1;
  }

  .marquee-half--top .marquee-item {
    color: #FFFFFF;
  }

  .marquee-half--bottom .marquee-item {
    color: #0A0A0A;
  }

  @keyframes marquee-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .marquee-split {
      height: clamp(3.5rem, 16vw, 6rem);
    }
    .marquee-item {
      font-size: clamp(3rem, 14vw, 5rem);
    }
  }
</style>
