---
// Hero.astro - Luxury Minimalist Dark Style
---

<section class="hero" id="hero">
  <div class="hero__bg">
    <!-- Overlay dark gradient for extreme contrast -->
    <div class="hero__overlay"></div>
    <div class="hero__image-wrapper fade-in">
      <img src="https://overlimit-bjj.sakura.ne.jp/fsj41442/wp-content/uploads/2021/08/dummy-hero.jpg" alt="Brailian Jiu Jitsu Action" class="hero__img img-luxury" onerror="this.onerror=null; this.src='data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%221600%22%20height%3D%22900%22%20viewBox%3D%220%200%201600%20900%22%3E%3Crect%20fill%3D%22%23111%22%20width%3D%221600%22%20height%3D%22900%22%2F%3E%3Cpath%20d%3D%22M0%20900%20L1600%200%22%20stroke%3D%22%23222%22%20stroke-width%3D%222%22%2F%3E%3Cpath%20d%3D%22M0%200%20L1600%20900%22%20stroke%3D%22%23222%22%20stroke-width%3D%222%22%2F%3E%3C%2Fsvg%3E';" />
    </div>
  </div>

  <!-- Giant faint background letters -->
  <div class="hero__bg-letter text-outline-thin">Y</div>

  <div class="hero__content container">
    <div class="hero__text-box">
      <h1 class="hero__title fade-up">OVER<br>LIMIT<br><span style="color:#FF5E1A">HONJO</span></h1>
      <p class="hero__subtitle fade-up" style="transition-delay: 0.2s;">
        BRAZILIAN JIU-JITSU ACADEMY
      </p>
      
      <div class="hero__action fade-up" style="transition-delay: 0.4s;">
        <a href="#contact" class="btn btn--white">
          <span>FREE TRIAL</span>
          <svg class="btn__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Vertical Japanese Copy -->
    <div class="hero__vert-text fade-up text-vertical" style="transition-delay: 0.6s;">
      柔 術 で 、<br>人 生 を 豊 か に 。
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: #000;
    overflow: hidden;
    padding-top: 80px; /* Offset for header */
  }

  /* Abstract background letter */
  .hero__bg-letter {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Inter', sans-serif;
    font-size: 110vh;
    font-weight: 300;
    line-height: 0.8;
    z-index: 1;
    opacity: 0.8;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__image-wrapper {
    width: 100%; height: 100%;
    /* Keep sharp edges. For hero, full bleed or inset */
    position: absolute;
    inset: 0;
  }

  /* On desktop, inset the image slightly for a magazine layout feel */
  @media (min-width: 993px) {
    .hero__image-wrapper {
      inset: 0 0 0 40%; /* Image only on the right half */
    }
  }

  .hero__img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    /* Already has .img-luxury grayscale filter */
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #000000 0%, #000000 40%, rgba(0,0,0,0.5) 70%, rgba(0,0,0,0.1) 100%);
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 80px;
  }

  .hero__text-box {
    max-width: 600px;
  }

  .hero__title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 200; /* Ultra thin luxury */
    letter-spacing: 0.15em;
    line-height: 1;
    color: #FFFFFF;
    margin-bottom: 24px;
    margin-left: -5px; /* Visual optical alignment */
  }

  .hero__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.4em;
    color: #AAAAAA;
    margin-bottom: 48px;
    position: relative;
    padding-left: 40px;
  }

  .hero__subtitle::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    width: 24px; height: 1px;
    background: #FF5E1A;
  }

  .hero__vert-text {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #FFFFFF;
    /* Use Noto Serif JP - styling is in global CSS .text-vertical */
  }

  @media (max-width: 992px) {
    .hero {
      align-items: flex-end;
    }
    .hero__overlay {
      background: linear-gradient(0deg, #000000 0%, rgba(0,0,0,0.7) 50%, rgba(0,0,0,0.2) 100%);
    }
    .hero__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
    }
    .hero__vert-text {
      /* Keep vertical, but position it differently or absolutely */
      position: absolute;
      top: 100px; right: 24px;
      font-size: 2rem;
    }
    .hero__subtitle { margin-bottom: 32px; }
  }
</style>
