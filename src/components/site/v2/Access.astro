---
// Access.astro - Redesigned based on fuckfuck.html with Orange theme
---

<section class="section access" id="access">
  <div class="wrap access-layout">
    <div class="access-info motion-left">
      <div class="section-head">
        <div>
          <p class="eyebrow">07 / Access</p>
          <h2>アクセス</h2>
        </div>
      </div>

      <p class="address">〒367-0042<br />埼玉県本庄市けや木1丁目1-16</p>

      <dl class="access-details">
        <div>
          <dt>ACCESS</dt>
          <dd>JR高崎線「本庄」駅北口より徒歩6分</dd>
        </div>
        <div>
          <dt>PARKING</dt>
          <dd>無料駐車場あり</dd>
        </div>
      </dl>

      <a
        class="text-link"
        href="https://www.google.com/maps/search/?api=1&query=Over+Limit+%E6%9C%AC%E5%BA%84+%E5%9F%BC%E7%8E%89%E7%9C%8C%E6%9C%AC%E5%BA%84%E5%B8%82%E3%81%91%E3%82%84%E6%9C%A81%E4%B8%81%E7%9B%AE1-16"
        target="_blank"
        rel="noopener"
      >
        Google Mapsで開く <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="map motion-right" data-motion-delay="0.15">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3218.2944780470243!2d139.1862549!3d36.2323399!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x601ec3eee3c93b9d%3A0x887398c7f6e244!2zT3ZlciBMaW1pdCDmnKzluoQ!5e0!3m2!1sja!2sjp!4v1774632235151!5m2!1sja!2sjp"
        title="Over Limit 本庄の所在地"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      >
      </iframe>
    </div>
  </div>
</section>

<style>
  .access {
    background: #e7eadd;
    padding-block: 108px;
    color: #141613;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .wrap {
    width: min(1220px, calc(100% - 48px));
    margin-inline: auto;
  }

  .access-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 72px;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Oswald', Impact, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ff6b00;
  }

  .eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    background: currentColor;
    flex-shrink: 0;
  }

  .section-head {
    margin-bottom: 30px;
    border-bottom: 2px solid #141613;
    padding-bottom: 20px;
  }

  .section-head h2 {
    margin: 8px 0 0;
    font-size: clamp(28px, 3.8vw, 44px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.25;
  }

  .address {
    font-size: 16px;
    line-height: 2;
    font-weight: 600;
  }

  .access-details {
    margin: 28px 0 30px;
  }

  .access-details > div {
    padding: 15px 0;
    border-bottom: 1px solid #cdd2c0;
  }

  .access-details dt {
    font-family: 'Oswald', Impact, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ff6b00;
    line-height: 1.5;
  }

  .access-details dd {
    margin: 6px 0 0;
    font-size: 13px;
    font-weight: 500;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 4px;
    border-bottom: 1.5px solid currentColor;
    font-size: 13px;
    font-weight: 700;
    transition: color 0.2s, border-color 0.2s;
    color: inherit;
    text-decoration: none;
  }

  .text-link:hover {
    color: #ff6b00;
    border-color: #ff6b00;
  }

  .map {
    border: 1px solid #cdd2c0;
    background: #d9dfd0;
  }

  .map iframe {
    display: block;
    width: 100%;
    height: 460px;
    border: 0;
  }

  @media (max-width: 1150px) {
    .access-layout {
      gap: 40px;
    }
  }

  @media (max-width: 700px) {
    .access {
      padding-block: 72px;
    }
    .wrap {
      width: calc(100% - 32px);
    }
    .access-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .map iframe {
      height: 340px;
    }
  }
</style>
