---
const reviews = [
  {
    name: 'Ichiro Matsumoto', image: 'ichiro-matsumoto.png', collapsible: true,
    body: 'とても広いマットスペースがあり、更衣スペースも保護者や見学の方が座って過ごせるスペースも十分にある素敵なジムです。\n\n代表のタシロ先生はとても気さくでフレンドリーな性格で、初めての方も緊張せず話すことができて、楽しく柔術を始めることができると思います。\n会員さんは日系ブラジリアンの方が多い印象ですが、どなたでも障壁なく柔術が楽しめるいいジムだと思います。',
  },
  {
    name: '100 mendou', image: '100-mendou.png',
    body: '上里町から本庄駅前に引っ越したばかりで白を基調にしたとてもキレイな柔術道場。先生はとても細かく丁寧に教えてくれます。\nスパーリングも自由参加、筋トレとか辛い指導はありません。',
  },
  {
    name: 'Eduardo Pereira', image: 'eduardo-pereira.png', translated: true,
    body: '最高です、本当におすすめです！柔術について素晴らしい指導が受けられますし、クラスの構成も非常にしっかりしていて、先生から直接指導を受けられます。',
  },
];
---

<section class="reviews-section" id="reviews" aria-labelledby="reviews-title">
  <div class="reviews-container">
    <div class="reviews-header">
      <div>
        <p class="reviews-source">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Google Reviews</span>
        </p>
        <h2 id="reviews-title">Googleマップのクチコミ</h2>
      </div>
      <p class="reviews-subtitle">Googleマップに寄せられたクチコミから掲載しています。</p>
    </div>

    <div class="reviews-track" id="reviews-track" data-reviews-track tabindex="0" role="region" aria-label="クチコミ一覧（横にスクロールできます）">
      {reviews.map(review => (
        <article class="review-card">
          <div class="card-header">
            <img src={'/site/reviews/' + review.image} alt="" width="40" height="40" class="avatar-img" loading="lazy" decoding="async" />
            <div class="user-meta">
              <h3 class="user-name">{review.name}</h3>
            </div>
          </div>
          <div class="card-stars" role="img" aria-label="星5つ">★★★★★</div>
          <p class="translation-note" data-review-source={review.translated ? 'pt' : 'ja'} hidden={!review.translated}>※ポルトガル語からの翻訳</p>
          {review.collapsible ? (
            <>
              <p class="review-body">{review.body.split('\n\n')[0]}</p>
              <details class="review-more">
                <summary><span class="read-more">続きを読む</span><span class="read-less">閉じる</span></summary>
                <p class="review-body">{review.body.split('\n\n').slice(1).join('\n\n')}</p>
              </details>
            </>
          ) : <p class="review-body">{review.body}</p>}
        </article>
      ))}
    </div>

    <div class="reviews-controls" data-reviews-controls hidden>
      <span class="review-position" data-review-position aria-hidden="true">01 / 03</span>
      <div class="review-arrows">
        <button type="button" class="slider-arrow" data-slider-prev aria-label="前のクチコミ" aria-controls="reviews-track" disabled>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <button type="button" class="slider-arrow" data-slider-next aria-label="次のクチコミ" aria-controls="reviews-track">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background: #fff;
    color: #141613;
    padding-block: 48px;
    font-family: 'Noto Sans JP', sans-serif;
    scroll-margin-top: 100px;
  }
  .reviews-container { width: min(1220px, calc(100% - 48px)); margin-inline: auto; }
  .reviews-header {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 24px;
    padding-bottom: 24px; border-bottom: 1px solid #dedfd9;
  }
  .reviews-source {
    display: flex; align-items: center; gap: 8px; margin: 0 0 12px;
    font-size: 12px; letter-spacing: .04em; color: #61655e;
  }
  .reviews-source svg { flex-shrink: 0; }
  h2 { margin: 0; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.4; letter-spacing: -.03em; font-weight: 700; }
  .reviews-subtitle { max-width: 270px; margin: 0 0 3px; font-size: 12px; color: #61655e; line-height: 1.8; }
  .reviews-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    scrollbar-width: thin; scrollbar-color: #a2a799 transparent; padding-block: 32px 12px;
  }
  .review-card { flex: 0 0 33.333333%; min-width: 0; box-sizing: border-box; padding-inline: 28px; scroll-snap-align: start; }
  .review-card:first-child { padding-left: 0; }
  .review-card:last-child { padding-right: 0; }
  .review-card + .review-card { border-left: 1px solid #dedfd9; }
  .card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .avatar-img { width:40px; height:40px; flex-shrink:0; object-fit:contain; }
  .user-meta { min-width: 0; }
  .user-name { margin: 0; font-size: 14px; font-weight: 700; line-height: 1.5; overflow-wrap: anywhere; }
  .card-stars { color: #b77900; font-size: 14px; letter-spacing: 2px; line-height: 1; margin-bottom: 16px; }
  .translation-note { font-size: 11px; color: #61655e; margin: 0 0 8px; }
  .review-body { font-size: 14px; line-height: 1.95; color: #373b34; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .review-more { margin-top: 8px; }
  .review-more summary { width: fit-content; min-height: 44px; padding-block: 10px; cursor: pointer; font-size: 13px; line-height: 24px; color: #373b34; text-decoration: underline; text-underline-offset: 4px; }
  .review-more summary:focus-visible { outline: 2px solid #141613; outline-offset: 4px; }
  .read-less, .review-more[open] .read-more { display: none; }
  .review-more[open] .read-less { display: inline; }
  .review-more[open] .review-body { margin-top: 8px; }
  .reviews-controls { display: flex; align-items: center; justify-content: space-between; margin-top: 16px; }
  .reviews-controls[hidden] { display: none; }
  .review-position { font-family: 'Oswald', sans-serif; font-size: 13px; letter-spacing: .12em; color: #61655e; font-variant-numeric: tabular-nums; }
  .review-arrows { display: flex; gap: 8px; }
  .slider-arrow { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; background: transparent; border: 1px solid #a2a799; color: #141613; cursor: pointer; }
  .slider-arrow:hover:not(:disabled) { background: #f4f4ee; border-color: #141613; }
  .slider-arrow:disabled { opacity: .3; cursor: default; }
  .slider-arrow:focus-visible, .reviews-track:focus-visible { outline: 2px solid #141613; outline-offset: 4px; }
  @media (max-width: 960px) {
    .reviews-header { display: block; }
    .reviews-subtitle { max-width: none; margin: 12px 0 0; }
    .review-card { flex-basis: 46%; padding-inline: 24px; }
  }
  @media (max-width: 640px) {
    .reviews-section { padding-block: 32px; }
    .reviews-container { width: calc(100% - 32px); }
    h2 { font-size: clamp(22px, 5.7vw, 26px); }
    .reviews-header { padding-bottom: 20px; }
    .reviews-track { padding-top: 24px; }
    .review-card { flex-basis: 88%; padding-inline: 20px; }
    .review-card:last-child { flex-basis: 100%; padding-right: 16px; }
    .review-body { font-size: 14px; line-height: 1.85; }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-reviews-track]');
  const controls = document.querySelector<HTMLElement>('[data-reviews-controls]');
  const prev = document.querySelector<HTMLButtonElement>('[data-slider-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-slider-next]');
  const position = document.querySelector<HTMLElement>('[data-review-position]');
  if (track && controls && prev && next && position) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.review-card'));
    const offsets = () => cards.map(card => card.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft);
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      controls.hidden = max < 2;
      track.tabIndex = max < 2 ? -1 : 0;
      prev.disabled = track.scrollLeft < 2;
      next.disabled = track.scrollLeft >= max - 2;
      const nearest = offsets().reduce((best, offset, index, list) => Math.abs(offset - track.scrollLeft) < Math.abs(list[best] - track.scrollLeft) ? index : best, 0);
      position.textContent = String(next.disabled ? cards.length : nearest + 1).padStart(2, '0') + ' / ' + String(cards.length).padStart(2, '0');
    };
    const move = (direction: number) => {
      const points = offsets();
      const target = direction > 0 ? points.find(offset => offset > track.scrollLeft + 2) : points.reverse().find(offset => offset < track.scrollLeft - 2);
      track.scrollTo({ left: target ?? (direction > 0 ? track.scrollWidth : 0), behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, { passive: true });
    const observer = new ResizeObserver(update);
    observer.observe(track);
    window.addEventListener('pagehide', () => observer.disconnect());
    window.addEventListener('pageshow', () => { observer.observe(track); update(); });
    update();
  }
</script>
