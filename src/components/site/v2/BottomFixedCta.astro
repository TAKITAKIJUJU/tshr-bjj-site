<style>
  .bottom-fixed-cta {
    position: fixed;
    z-index: 990;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgba(0, 0, 0, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .bottom-fixed-cta__inner {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 8px;
    max-width: 540px;
    margin: 0 auto;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 48px;
    padding: 10px 6px;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: clamp(11.5px, 3.2vw, 13px);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: #ffffff;
    text-align: center;
    white-space: nowrap;
    border-radius: 4px;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .cta-btn--line {
    background: #06c755;
    color: #141613;
    border: 1.5px solid #06c755;
  }

  .cta-btn--line:hover {
    background: #22d968;
    border-color: #22d968;
    color: #141613;
  }

  .cta-btn--trial {
    background: #ff6b00;
    color: #141613;
    border: 1.5px solid #ff6b00;
  }

  .cta-btn--trial:hover {
    background: #ff8533;
    border-color: #ff8533;
    transform: translateY(-1px);
  }

  .cta-icon {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .cta-icon--line path:not(:first-child), .cta-icon--line rect { fill: #06c755; }

  .cta-btn--trial:hover .cta-icon {
    transform: translateY(-1px) scale(1.08);
  }

  .cta-btn--line:hover .cta-icon {
    transform: scale(1.1);
  }

  :global(html:lang(en)) .cta-btn,
  :global(html:lang(pt)) .cta-btn {
    font-size: 11px;
    padding: 10px 4px;
    gap: 4px;
  }

  .bottom-fixed-cta .cta-btn:is(:hover, :focus, :focus-visible, :active) { color: #141613; }
  .bottom-fixed-cta .cta-btn:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }

</style>
