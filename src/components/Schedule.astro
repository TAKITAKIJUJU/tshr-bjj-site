          <span class="schedule__m-day-jp">水曜日</span>
        </div>
        <div class="schedule__m-classes">
          <div class="s-card s-card--all s-card--mobile">
            <span class="s-name">オールレベル柔術</span>
            <span class="s-time">10:00-11:30</span>
          </div>
          <div class="s-card s-card--beginner s-card--mobile">
            <span class="s-name">ビギナー柔術</span>
            <span class="s-time">19:00-20:00</span>
          </div>
          <div class="s-card s-card--all s-card--mobile">
            <span class="s-name">オールレベル柔術</span>
            <span class="s-time">20:30-22:00</span>
          </div>
        </div>
      </div>

      <!-- Thu -->
