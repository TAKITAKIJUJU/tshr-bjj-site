</section>

<style is:global>
  .schedule {
    padding: 120px 0;
  }
  
  .schedule__header {
    text-align: center;
    margin-bottom: 40px;
  }

  /* ===== Horizontal Scrollable Table ===== */
  .schedule__desktop {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: #FFFFFF;
    border-radius: 8px; /* Clean, tight radius */
    padding: 0 0 24px 0;
    margin-bottom: 24px;
    
    /* Scrollbar styling for better UX */
    scrollbar-color: #CCCCCC transparent;
    scrollbar-width: thin;
  }

  .schedule__desktop::-webkit-scrollbar {
    height: 6px;
  }
  .schedule__desktop::-webkit-scrollbar-track {
    background: transparent;
  }
  .schedule__desktop::-webkit-scrollbar-thumb {
    background-color: #CCCCCC;
    border-radius: 6px;
  }

  .schedule__t {
    width: 100%;
    min-width: 860px; /* Ensure it stays wide enough to force scroll on mobile */
    border-collapse: collapse;
    table-layout: fixed;
  }

  .schedule__t th {
    font-family: 'Inter', 'Noto Sans JP', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #666666;
    padding: 16px 8px;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    background: #F8F9FA;
  }

  .schedule__t td {
    vertical-align: top;
    height: 80px; 
    border: 1px solid rgba(0,0,0,0.03);
    padding: 8px;
  }

  /* Specific Card Styling (Flat, clean) */
  .s-card {
    border-radius: 6px;
    padding: 12px 6px;
    text-align: center;
    color: #FFF;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 64px;
    transition: opacity 0.2s ease;
  }

  .s-card:hover {
    opacity: 0.85;
  }

  .s-card--all { background-color: #1A1A1A; } /* Sleek black */
  .s-card--beginner { background-color: #5CB88A; } /* Yawara style Green */
  .s-card--kids { background-color: #F89B5B; } /* Orange */
  .s-card--nogi { background-color: #D94848; } /* Red */

  .s-name {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .s-time {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    opacity: 0.8;
  }

  /* ===== Legend ===== */
  .schedule__legend {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .schedule__legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: #666;
  }

  .schedule__legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .schedule__note {
    text-align: center;
    font-size: 0.8rem;
    color: #888;
    line-height: 1.8;
  }

  .schedule__scroll-hint {
    display: none;
    font-weight: 600;
    color: #444;
  }

  @media (max-width: 768px) {
    .schedule { padding: 80px 0; }
    
    .schedule__scroll-hint {
      display: inline-block;
      margin-top: 8px;
    }
    
    /* Extra shrinking for mobile to make it look elegant and not squished */
    .s-card {
      padding: 8px 4px;
      min-height: 56px;
    }
    
    .s-name {
      font-size: 0.7rem; /* Significantly smaller */
    }
    
    .s-time {
      font-size: 0.65rem; /* Significantly smaller */
    }
    
    .schedule__t th {
      font-size: 0.8rem;
      padding: 12px 4px;
    }
    
    .schedule__t td {
      padding: 4px;
      height: 64px;
    }
  }
</style>
