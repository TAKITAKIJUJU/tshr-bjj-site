---
// Schedule.astro - Luxury Minimalist Dark Style
---

<section class="schedule section--dark" id="schedule">
  <div class="container">
    <div class="schedule__header fade-up">
      <span class="section-label">04 / SCHEDULE</span>
      <h2 class="section-title--jp">スケジュール</h2>
    </div>

    <!-- ===== Legend ===== -->
    <div class="schedule__legend fade-up">
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:#FFFFFF;"></span>
        <span>オールレベル</span>
      </div>
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:transparent; border: 1px solid #FFF;"></span>
        <span>ビギナー</span>
      </div>
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:#FF5E1A;"></span>
        <span>キッズ</span>
      </div>
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:transparent; border: 1px solid #FF5E1A;"></span>
        <span>NOGI</span>
      </div>
    </div>

    <!-- ===== Timetable (Scrollable on Mobile) ===== -->
    <div class="schedule__desktop fade-up">
      <table class="schedule__t">
        <thead>
          <tr>
            <th>月</th>
            <th>火</th>
            <th>水</th>
            <th>木</th>
            <th>金</th>
            <th>土</th>
            <th>日</th>
          </tr>
        </thead>
        <tbody>
          <!-- Row 1: 10:00 - 11:30 -->
          <tr>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">10:00-11:30</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">10:00-11:30</div>
              </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
          </tr>

          <!-- Row 2: 18:00 - 19:00 -->
          <tr>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">18:00-19:00</div>
              </div>
            </td>
            <td></td>
            <td></td>
          </tr>

          <!-- Row 3: 19:00 - 20:00 -->
          <tr>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td></td>
          </tr>

          <!-- Row 4: 20:30 - 22:00 -->
          <tr>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">20:30-22:00</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">20:30-22:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--nogi">
                <div class="s-name">NOGI</div>
                <div class="s-time">20:30-22:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">20:30-22:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">20:30-22:00</div>
              </div>
            </td>
            <td></td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="schedule__note fade-up">
      ※ スケジュールは予告なく変更になる場合がございます。休館日は <a href="https://www.instagram.com/tshr_jiujitsu/" target="_blank" rel="noopener" style="text-decoration: underline; color: #FFF;">Instagram</a> をご確認ください。<br>
      <span class="schedule__scroll-hint">※スマートフォンでは表を横にスワイプしてご覧いただけます。</span>
    </p>
  </div>
</section>

<style is:global>
  .schedule {
    padding: 180px 0;
    background: #000;
  }
  
  .schedule__header {
    text-align: center;
    margin-bottom: 60px;
  }

  /* ===== Horizontal Scrollable Table ===== */
  .schedule__desktop {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: transparent;
    padding: 0 0 24px 0;
    margin-bottom: 24px;
    
    scrollbar-color: #333 transparent;
    scrollbar-width: thin;
  }

  .schedule__desktop::-webkit-scrollbar { height: 4px; }
  .schedule__desktop::-webkit-scrollbar-track { background: transparent; }
  .schedule__desktop::-webkit-scrollbar-thumb { background-color: #333; }

  .schedule__t {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
    table-layout: fixed;
    border: 1px solid rgba(255,255,255,0.15); /* Outer sharp border */
  }

  .schedule__t th {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    padding: 24px 8px;
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    border-right: 1px solid rgba(255,255,255,0.05);
    background: #0A0A0A;
  }

  .schedule__t td {
    vertical-align: top;
    height: 90px; 
    border-bottom: 1px solid rgba(255,255,255,0.05);
    border-right: 1px solid rgba(255,255,255,0.05);
    padding: 4px;
    background: #000;
  }

  /* Specific Card Styling (Sharp, minimalist, B/W/Orange) */
  .s-card {
    border-radius: 0; /* No rounding */
    padding: 12px 6px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 72px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .s-card:hover {
    background: #111;
  }

  /* Using purely Black, White, and Orange */
  .s-card--all { 
    background-color: #FFFFFF;
    color: #000;
  }
  
  .s-card--beginner { 
    background-color: transparent;
    border-color: #FFFFFF;
    color: #FFF;
  }
  
  .s-card--kids { 
    background-color: #FF5E1A; 
    color: #FFF;
  }
  
  .s-card--nogi { 
    background-color: transparent;
    border-color: #FF5E1A;
    color: #FF5E1A;
  }

  .s-name {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.05em;
  }

  .s-time {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    opacity: 0.9;
  }

  /* ===== Legend ===== */
  .schedule__legend {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .schedule__legend-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    color: #AAAAAA;
    letter-spacing: 0.1em;
  }

  .schedule__legend-dot {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .schedule__note {
    text-align: center;
    font-size: 0.8rem;
    color: #666;
    line-height: 1.8;
  }

  .schedule__scroll-hint {
    display: none;
    font-weight: 400;
    color: #888;
  }

  @media (max-width: 768px) {
    .schedule { padding: 100px 0; }
    
    .schedule__scroll-hint {
      display: inline-block;
      margin-top: 16px;
    }
    
    .s-card {
      padding: 8px 4px;
      min-height: 64px;
    }
    
    .s-name { font-size: 0.7rem; }
    .s-time { font-size: 0.65rem; }
    
    .schedule__t th {
      font-size: 0.8rem;
      padding: 16px 4px;
    }
    
    .schedule__t td {
      padding: 2px;
      height: 64px;
    }
  }
</style>
