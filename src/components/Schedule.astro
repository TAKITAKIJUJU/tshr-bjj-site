---
// Schedule - Minimal YAWARA/Hacomono inspired timetable
---

<section class="schedule section--white" id="schedule">
  <div class="container">
    <div class="schedule__header motion-up">
      <span class="section-label">Schedule</span>
      <h2 class="section-title--jp">スケジュール</h2>
    </div>

    <!-- ===== Legend ===== -->
    <div class="schedule__legend motion-fade" data-motion-delay="0.08">
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:#2563EB;"></span>
        <span>オールレベル</span>
      </div>
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:#059669;"></span>
        <span>ビギナー</span>
      </div>
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:#F97316;"></span>
        <span>キッズ</span>
      </div>
      <div class="schedule__legend-item">
        <span class="schedule__legend-dot" style="background:#7C3AED;"></span>
        <span>NOGI</span>
      </div>
    </div>

    <!-- ===== Timetable (Scrollable on Mobile) ===== -->
    <div class="schedule__desktop motion-scale" data-motion-delay="0.16">
      <table class="schedule__t">
        <thead>
          <tr>
            <th>月</th>
            <th>火</th>
            <th>水</th>
            <th>木</th>
            <th>金</th>
            <th>土</th>
            <th>日</th>
          </tr>
        </thead>
        <tbody>
          <!-- Row 1: 10:00 - 11:30 -->
          <tr>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">10:00-11:30</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">10:00-11:30</div>
              </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
          </tr>

          <!-- Row 2: 18:00 - 19:00 -->
          <tr>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">18:00-19:00</div>
              </div>
            </td>
            <td></td>
            <td></td>
          </tr>

          <!-- Row 3: 19:00 - 20:00 -->
          <tr>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td></td>
          </tr>

          <!-- Row 4: 20:30 - 22:00 -->
          <tr>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">20:30-22:00</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">20:30-22:00</div>
              </div>
