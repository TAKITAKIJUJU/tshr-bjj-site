    <p class="schedule__note motion-up">
      ※ スケジュールは予告なく変更になる場合がございます。最新の休館日などは <a href="https://www.instagram.com/tshr_jiujitsu/" target="_blank" rel="noopener" style="text-decoration: underline;">Instagram</a> をご確認ください。<br>
      <span class="schedule__scroll-hint">※スマートフォンでは表を横にスクロールしてご覧いただけます。</span>
    </p>
  </div>
</section>

<style is:global>
  .schedule {
    padding: clamp(82px, 9vw, 104px) 0;
    background: transparent;
  }
  
  .schedule__header {
    text-align: center;
    margin-bottom: 32px;
  }

  /* ===== Horizontal Scrollable Table ===== */
  .schedule__desktop {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(249,249,251,0.88));
    border: none;
    border-radius: 18px;
    padding: 0 0 24px 0;
    margin-bottom: 20px;
    box-shadow:
      16px 16px 32px rgba(156, 166, 189, 0.3),
      -14px -14px 28px rgba(255, 255, 255, 0.92);
    
    /* Scrollbar styling for better UX */
    scrollbar-color: #CCCCCC transparent;
    scrollbar-width: thin;
  }

  .schedule__desktop::-webkit-scrollbar {
    height: 6px;
  }
  .schedule__desktop::-webkit-scrollbar-track {
    background: transparent;
  }
  .schedule__desktop::-webkit-scrollbar-thumb {
    background-color: #CCCCCC;
    border-radius: 6px;
  }

  .schedule__t {
    width: 100%;
    min-width: 860px; /* Ensure it stays wide enough to force scroll on mobile */
    border-collapse: collapse;
    table-layout: fixed;
  }

  .schedule__t th {
    font-family: 'Inter', 'Noto Sans JP', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #666666;
    padding: 16px 8px;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    background: rgba(246, 246, 248, 0.86);
  }

  .schedule__t td {
    vertical-align: top;
    height: 80px; 
    border: 1px solid rgba(0,0,0,0.05);
    padding: 8px;
  }

  /* Specific Card Styling (Flat, clean) */
  .s-card {
    border-radius: 9px;
    padding: 12px 6px;
    text-align: center;
    color: #FFF;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 64px;
    box-shadow:
      inset 3px 3px 8px rgba(255, 255, 255, 0.2),
      inset -4px -4px 10px rgba(0, 0, 0, 0.14),
      6px 6px 16px rgba(0, 0, 0, 0.16);
    transition: opacity 0.2s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .s-card:hover {
    opacity: 0.85;
    transform: translateY(-2px);
    box-shadow:
      inset 3px 3px 9px rgba(255, 255, 255, 0.24),
      inset -4px -4px 10px rgba(0, 0, 0, 0.16),
      10px 10px 20px rgba(0, 0, 0, 0.2);
  }

  .s-card--all { background-color: #2563EB; }
  .s-card--beginner { background-color: #059669; }
  .s-card--kids { background-color: #F97316; }
  .s-card--nogi { background-color: #7C3AED; }

  .s-name {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .s-time {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    opacity: 0.8;
  }

  /* ===== Legend ===== */
  .schedule__legend {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .schedule__legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: #666;
  }

  .schedule__legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .schedule__note {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    font-size: 0.8rem;
    color: #888;
    line-height: 1.8;
  }

  .schedule__scroll-hint {
    display: none;
    font-weight: 600;
    color: #444;
  }

  @media (max-width: 768px) {
    .schedule { padding: 58px 0; }
    
    .schedule__scroll-hint {
      display: inline-block;
      margin-top: 8px;
    }
    
    /* Extra shrinking for mobile to make it look elegant and not squished */
    .s-card {
      padding: 8px 4px;
      min-height: 56px;
    }
    
    .s-name {
      font-size: 0.7rem; /* Significantly smaller */
    }
    
    .s-time {
      font-size: 0.65rem; /* Significantly smaller */
    }
    
    .schedule__t th {
      font-size: 0.8rem;
      padding: 12px 4px;
    }
    
    .schedule__t td {
      padding: 4px;
      height: 64px;
    }
  }
</style>

