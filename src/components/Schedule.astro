          <tr>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">10:00-11:30</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">10:00-11:30</div>
              </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
          </tr>

          <!-- Row 2: 18:00 - 19:00 -->
          <tr>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">18:00-19:00</div>
              </div>
            </td>
            <td></td>
            <td></td>
          </tr>

          <!-- Row 3: 19:00 - 20:00 -->
          <tr>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td></td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--beginner">
                <div class="s-name">ビギナー柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td>
              <div class="s-card s-card--kids">
                <div class="s-name">キッズ柔術</div>
                <div class="s-time">19:00-20:00</div>
              </div>
            </td>
            <td></td>
          </tr>

          <!-- Row 4: 20:30 - 22:00 -->
          <tr>
            <td>
              <div class="s-card s-card--all">
                <div class="s-name">オールレベル柔術</div>
                <div class="s-time">20:30-22:00</div>
              </div>
