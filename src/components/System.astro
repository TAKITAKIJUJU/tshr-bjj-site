---
// System / Pricing - Exact Data from Old Site (YAWARA refined style)
---

<section class="system section--dark" id="system">
  <div class="container">
    <div class="system__header fade-up">
      <span class="section-label" style="color: #666;">Price</span>
      <h2 class="section-title--jp" style="color: #FFF;">料金システム</h2>
      <p class="section-subtitle" style="color: #999;">
        あなたのライフスタイルに合わせたプランをご用意しています。
      </p>
      
      <!-- Special Campaign / Discounts -->
      <div class="system__campaign">
        <span class="campaign-badge">入会金 無料</span>
        <span class="campaign-text">年一括払いで<strong>15%OFF</strong> ｜ 家族との同時入会で<strong>10%OFF</strong></span>
      </div>

      <!-- Scroll hint for mobile (Enhanced visibility) -->
      <div class="system__scroll-hint fade-up" style="transition-delay: 0.1s;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="scroll-icon">
          <!-- Double arrow pointing right to indicate swiping/scrolling -->
          <path d="M13 17l5-5-5-5M6 17l5-5-5-5"/>
        </svg>
        <span>横にスワイプしてすべてのプランを表示</span>
      </div>
    </div>

    <div class="system__grid">
      <!-- Full Time (Men) -->
      <div class="system__card card fade-up">
        <h3 class="system__plan-name">フルタイム会員<span class="system__plan-sub">(一般男性)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥9,800</span>
          <span class="system__price-unit">/月 (税込)</span>
        </div>
        <ul class="system__features">
          <li>通い放題（全クラス参加可能）</li>
          <li>スパーリング・フリースパー参加可</li>
          <li>すべての設備が使い放題</li>
        </ul>
      </div>

      <!-- Full Time (Women / Students) -->
      <div class="system__card card fade-up" style="transition-delay: 0.1s;">
        <h3 class="system__plan-name">フルタイム会員<span class="system__plan-sub">(女性・中高生)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥7,800</span>
          <span class="system__price-unit">/月 (税込)</span>
        </div>
        <ul class="system__features">
          <li>通い放題（全クラス参加可能）</li>
          <li>女性や学生も安心して通える環境</li>
          <li>すべての設備が使い放題</li>
        </ul>
      </div>

      <!-- Kids -->
      <div class="system__card card fade-up" style="transition-delay: 0.2s;">
        <h3 class="system__plan-name">キッズ会員<span class="system__plan-sub">(小学1〜6年生)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥5,000</span>
          <span class="system__price-unit">/月 (税込)</span>
        </div>
        <ul class="system__features">
          <li>キッズクラス参加可能</li>
          <li>礼儀作法や基礎体力の向上</li>
          <li>楽しく安全に柔術を学べます</li>
        </ul>
      </div>

      <!-- Visitor moved inside the grid -->
      <div class="system__card card fade-up" style="transition-delay: 0.3s;">
        <h3 class="system__plan-name">ビジター <span class="system__plan-sub">(1回利用)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥2,200</span>
          <span class="system__price-unit">/回 (税込)</span>
        </div>
        <ul class="system__features">
          <li>1回のみのスポット利用</li>
          <li>出張や旅行中の練習に</li>
          <li>当日お支払い</li>
        </ul>
      </div>
    </div>
    
    <div class="system__actions fade-up" style="text-align: center; margin-top: 48px;">
      <a href="#contact" class="btn btn--white" style="min-width: 240px;">体験・入会お申し込み</a>
    </div>
  </div>
</section>

<style>
  .system {
    padding: 120px 0;
    background: #111111; /* Deep premium black */
    color: #FFF;
  }

  .system__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .system__campaign {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  .campaign-badge {
    background: #FFF;
    color: #111;
    font-weight: 700;
    font-size: 0.75rem;
    padding: 4px 12px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .campaign-text {
    font-size: 0.85rem;
    font-weight: 400;
    color: #CCC;
  }
  
  .campaign-text strong {
    color: #FFF;
    font-weight: 600;
  }

  .system__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* 2x2 on smaller tablets */
    gap: 24px;
    margin-bottom: 24px;
  }

  @media (min-width: 1024px) {
    .system__grid {
      grid-template-columns: repeat(4, 1fr); /* 4 in a row on desktop */
    }
  }

  .system__card {
    background: #1A1A1A; /* Slightly lighter than the background section */
    border: 1px solid rgba(255,255,255,0.05); /* Very faint border */
    border-radius: 12px;
    padding: 40px 24px; /* Reduced horizontal padding to fit 4 cards */
    display: flex;
    flex-direction: column;
    text-align: left;
    transition: background 0.4s ease, border-color 0.4s ease;
  }

  .system__card:hover {
    background: #222222;
    border-color: rgba(255,255,255,0.1);
    transform: none; /* No vertical movement, keep it flat and elegant */
    box-shadow: none;
  }

  .system__plan-name {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #FFF;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .system__plan-sub {
    font-size: 0.8rem;
    font-weight: 400;
    color: #888;
  }

  .system__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 24px;
  }

  .system__price-value {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: 0;
    color: #FFF;
  }

  .system__price-unit {
    font-size: 0.75rem;
    color: #888;
  }

  .system__features {
    list-style: none;
    flex: 1;
  }

  .system__features li {
    font-size: 0.8rem;
    color: #AAA;
    padding: 8px 0;
    line-height: 1.6;
    position: relative;
    padding-left: 20px;
  }

  .system__features li::before {
    content: "・";
    position: absolute;
    left: 0;
    color: #666;
  }



  .system__scroll-hint {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 40px;
    font-size: 0.9rem;
    color: #FF5E1A; /* Accent orange for visibility */
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .scroll-icon {
    animation: swipeAnim 1.5s infinite ease-in-out;
  }

  @keyframes swipeAnim {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(6px); }
  }

  @media (max-width: 768px) {
    .system { padding: 80px 0; }
    
    .system__scroll-hint { display: flex; }

    /* Swipeable modern card layout */
    .system__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 24px; 
      /* Breakout of container padding to allow edge-to-edge swipe */
      margin-left: -20px; 
      margin-right: -20px;
      padding-left: 20px; /* Align first card with container */
      padding-right: 20px;
      -webkit-overflow-scrolling: touch;
      /* Hide scrollbar for a native app feel */
      scrollbar-width: none;
    }
    
    .system__grid::-webkit-scrollbar {
      display: none;
    }

    .system__card {
      min-width: 85vw; /* Make card take 85% of screen to hint next card */
      scroll-snap-align: center; /* Snap cards to center */
      flex-shrink: 0;
    }

    .system__campaign {
      flex-direction: column;
      gap: 12px;
    }

    .system__visitor {
      display: none; /* Already removed from HTML, keeping safety */
    }
  }
</style>
