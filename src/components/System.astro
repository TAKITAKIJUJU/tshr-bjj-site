---
// System / Pricing - Exact Data from Old Site (YAWARA refined style)
---

<section class="system section--dark" id="system">
  <div class="container">
    <div class="system__header motion-up">
      <span class="section-label" style="color: rgba(255,255,255,0.86);">Price</span>
      <h2 class="section-title--jp" style="color: #FFF;">料金システム</h2>
      <p class="section-subtitle" style="color: rgba(255,255,255,0.9);">
        あなたのライフスタイルに合わせたプランをご用意しています。
      </p>
      
      <!-- Special Campaign / Discounts -->
      <div class="system__campaign">
        <span class="campaign-badge">入会金 無料</span>
        <span class="campaign-text">年一括払いで<strong>15%OFF</strong> ｜ 家族との同時入会で<strong>10%OFF</strong></span>
      </div>

      <!-- Scroll hint for mobile (Enhanced visibility) -->
      <div class="system__scroll-hint motion-up" data-motion-delay="0.1">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="scroll-icon">
          <!-- Double arrow pointing right to indicate swiping/scrolling -->
          <path d="M13 17l5-5-5-5M6 17l5-5-5-5"/>
        </svg>
        <span>横にスワイプしてすべてのプランを表示</span>
      </div>
    </div>

    <div class="system__grid">
      <!-- Full Time (Men) -->
      <div class="system__card card motion-scale">
        <h3 class="system__plan-name">フルタイム会員<span class="system__plan-sub">(一般男性)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥9,800</span>
          <span class="system__price-unit">/月 (税込)</span>
        </div>
        <ul class="system__features">
          <li>通い放題（全クラス参加可能）</li>
          <li>スパーリング・フリースパー参加可</li>
          <li>すべての設備が使い放題</li>
        </ul>
      </div>

      <!-- Full Time (Women / Students) -->
      <div class="system__card card motion-scale" data-motion-delay="0.08">
        <h3 class="system__plan-name">フルタイム会員<span class="system__plan-sub">(女性・中高生)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥7,800</span>
          <span class="system__price-unit">/月 (税込)</span>
        </div>
        <ul class="system__features">
          <li>通い放題（全クラス参加可能）</li>
          <li>女性や学生も安心して通える環境</li>
          <li>すべての設備が使い放題</li>
        </ul>
      </div>

      <!-- Kids -->
      <div class="system__card card motion-scale" data-motion-delay="0.16">
        <h3 class="system__plan-name">キッズ会員<span class="system__plan-sub">(小学1〜6年生)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥5,000</span>
          <span class="system__price-unit">/月 (税込)</span>
        </div>
        <ul class="system__features">
          <li>キッズクラス参加可能</li>
          <li>礼儀作法や基礎体力の向上</li>
          <li>楽しく安全に柔術を学べます</li>
        </ul>
      </div>

      <!-- Visitor moved inside the grid -->
      <div class="system__card card motion-scale" data-motion-delay="0.24">
        <h3 class="system__plan-name">ビジター <span class="system__plan-sub">(1回利用)</span></h3>
        <div class="system__price">
          <span class="system__price-value">¥2,200</span>
          <span class="system__price-unit">/回 (税込)</span>
        </div>
        <ul class="system__features">
          <li>1回のみのスポット利用</li>
          <li>出張や旅行中の練習に</li>
          <li>当日お支払い</li>
        </ul>
      </div>
    </div>
    
  </div>
</section>

<style>
  .system {
    padding: clamp(82px, 9vw, 104px) 0;
    background: linear-gradient(135deg, #ff7a18 0%, #e52d27 100%);
    color: #FFFFFF;
  }

  .system::before {
    content: none !important;
    display: none !important;
  }

  .system__header {
    text-align: center;
    margin-bottom: clamp(44px, 6vw, 56px);
  }

  .system__campaign {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }

  .campaign-badge {
    background: #FFF;
    color: #111;
    font-weight: 700;
    font-size: 0.75rem;
    padding: 4px 12px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .campaign-text {
    font-size: 0.85rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92);
  }
  
  .campaign-text strong {
    color: #FFFFFF;
    font-weight: 600;
  }

  .system__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* 2x2 on smaller tablets */
    gap: 20px;
    margin-bottom: 20px;
  }

  @media (min-width: 1024px) {
    .system__grid {
      grid-template-columns: repeat(4, 1fr); /* 4 in a row on desktop */
    }
  }

  .system__card {
    background: #F7F8FA !important;
    border: 1px solid rgba(15, 23, 42, 0.08) !important;
    border-radius: 24px;
    padding: 34px 22px;
    display: flex;
    flex-direction: column;
    text-align: left;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.06),
      0 10px 24px rgba(15, 23, 42, 0.08) !important;
    transition: background 0.4s ease, box-shadow 0.45s ease;
  }

  .system__card:hover {
    background: #F7F8FA !important;
    transform: translateY(-3px);
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.08),
      0 14px 28px rgba(15, 23, 42, 0.1) !important;
  }

  .system__plan-name {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #111111;
    margin-bottom: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .system__plan-sub {
    font-size: 0.8rem;
    font-weight: 400;
    color: #666666;
  }

  .system__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 26px;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    padding-bottom: 20px;
  }

  .system__price-value {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: 0;
    color: #111111;
  }

  .system__price-unit {
    font-size: 0.75rem;
    color: #666666;
  }

  .system__features {
    list-style: none;
    flex: 1;
  }

  .system__features li {
    font-size: 0.8rem;
    color: #333333;
    padding: 8px 0;
    line-height: 1.6;
    position: relative;
    padding-left: 20px;
  }

  .system__features li::before {
    content: "・";
    position: absolute;
    left: 0;
    color: #666666;
  }



  .system__scroll-hint {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
    font-size: 0.9rem;
    color: #FFFFFF;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .scroll-icon {
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .system { padding: 58px 0; }
    
    .system__scroll-hint { display: flex; }

    /* Swipeable modern card layout */
    .system__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 24px;
      padding-left: 2px;
      padding-right: 18px;
      -webkit-overflow-scrolling: touch;
      /* Hide scrollbar for a native app feel */
      scrollbar-width: none;
    }
    
    .system__grid::-webkit-scrollbar {
      display: none;
    }

    .system__card {
      min-width: calc(100vw - 92px);
      max-width: calc(100vw - 92px);
      scroll-snap-align: start;
      flex-shrink: 0;
    }

    .system__campaign {
      flex-direction: column;
      gap: 12px;
    }

    .system__visitor {
      display: none; /* Already removed from HTML, keeping safety */
    }
  }
</style>



