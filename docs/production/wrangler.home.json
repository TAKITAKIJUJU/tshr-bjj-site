{
  "name": "tshr-bjj-home",
  "main": "./home-worker.js",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern":"tshr-bjj.com/","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/english","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/english/*","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/portugues","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/portugues/*","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/gunma","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/gunma/*","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/contact","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/contact/*","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/privacy","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/privacy/*","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/thanks","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/thanks/*","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/sitemap.xml","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/favicon.ico","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/apple-touch-icon.png","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/apple-touch-icon-precomposed.png","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/LOGO.png","zone_name":"tshr-bjj.com"},
    {"pattern":"tshr-bjj.com/site/*","zone_name":"tshr-bjj.com"},
    {"pattern":"www.tshr-bjj.com/*","zone_name":"tshr-bjj.com"}
  ],
  "assets": {
    "directory": "../../local-assets/production-release",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  }
}
