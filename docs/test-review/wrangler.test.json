{
  "name": "tshr-bjj-test-preview",
  "main": "./test-worker.js",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tshr-bjj.com/test", "zone_name": "tshr-bjj.com" },
    { "pattern": "tshr-bjj.com/test/*", "zone_name": "tshr-bjj.com" }
  ],
  "assets": {
    "directory": "./deploy-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  }
}
